extends layout.pug

block content
  .container
    h1 SmartVue Photos v0.1
    br
    h2 Sélection des images à trier
    br
    form(action="/upload" method="post" enctype="multipart/form-data")
      label(for="fileInput") Sélection du fichier:
      br
      input#fileInput(type="file" name="file")
      br
      br
      button(type="submit") Trier la photo
